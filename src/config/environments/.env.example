############################ SERVER CONFIGURATION #############################
#
# Port on which the HTTP server will listen.
# If no port is provided, the server automatically select port 3000.

PORT=3000

# Log format of requests received by the server.
# All available formats and examples can be found on morgan's official page
# https://github.com/expressjs/morgan

LOGGER_FORMAT=dev

# API key authentication for protected endpoints.
# When enabled, /metrics, /health and /healthcheck require a key.
# API_KEY_AUTH_ENABLED=true
# API_KEY_HEADER=x-api-key
# API_KEYS=replace-with-long-random-key,second-key-for-rotation
#
# Optional bypass for operational endpoints reached through trusted internal hosts.
# When enabled, requests to the configured paths skip API key validation if the
# Host header matches one of the configured internal hosts.
# INTERNAL_AUTH_BYPASS_ENABLED=false
# INTERNAL_AUTH_BYPASS_PATHS=/metrics,/status,/healthcheck
# INTERNAL_AUTH_BYPASS_HOSTS=localhost,127.0.0.1,::1,tradapi-prd-tradapi,tradapi-prd-tradapi.vlibras.svc.cluster.local

# Standalone gloss refinement endpoint.
# When enabled, POST /refine becomes available and always requires an API key.
# GLOSS_REFINEMENT_ENABLED=false

# Trust X-Forwarded-* headers from a reverse proxy such as Istio/Envoy.
# TRUST_PROXY=true

# Fixed-window rate limiting for all endpoints.
# Keys are composed from client IP + Authorization header when present.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Stricter limit for translation endpoints.
TRANSLATE_RATE_LIMIT_WINDOW_MS=60000
TRANSLATE_RATE_LIMIT_MAX_REQUESTS=20

# Enable Swagger UI docs.
# Default behavior in code:
# - NODE_ENV=production -> disabled unless DOCS_ENABLED=true
# - other environments -> enabled unless DOCS_ENABLED=false
# DOCS_ENABLED=false

# Comma-separated list of allowed browser origins for the main API.
# If omitted, the main API keeps the current permissive behavior.
# CORS_ALLOWED_ORIGINS=https://app.example.gov.br,https://admin.example.gov.br

# Comma-separated allowlists for monitoring endpoints.
# Requests without Origin header are still accepted.
# If omitted, browser requests with Origin to /health and /metrics are denied.
# HEALTH_CORS_ALLOWED_ORIGINS=https://monitor.example.gov.br
# METRICS_CORS_ALLOWED_ORIGINS=https://monitor.example.gov.br

# Comma-separated allowlist for the detailed internal health endpoint (/status).
# In production, if omitted, /status is not exposed.
# INTERNAL_STATUS_ALLOWED_IPS=127.0.0.1,10.0.0.10

############################ METRICS CONFIGURATION ############################
#
# GET /metrics é servido por views materializadas criadas pela migration
# 20260821140000-metrics-aggregates. As views cobrem apenas dias fechados em
# UTC; o dia corrente é contado direto nas tabelas.

# Intervalo do refresh automático das views, em milissegundos (padrão 86400000,
# diário). As views cobrem apenas dias fechados, então refresh mais frequente
# varre as tabelas sem nada novo para agregar. O intervalo conta a partir do
# boot; para fixar a janela (madrugada), use 0 e dispare por cron/job.
# METRICS_REFRESH_INTERVAL_MS=86400000

#### PostgreSQL DB Configuration
POSTGRES_USERNAME=vlibras
POSTGRES_PASSWORD=vlibras
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=vlibrasdb

############################ CACHE CONFIGURATION ##############################
#
# Server communication settings with Redis.
# By default, this file configures the server to connect to the cache using the
# default Redis settings. The cache is set to a max size of 100MB and each item
# remains cached for a maximum of one week.

CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_NAME=vlibras-cache

# ATENTION: Uncomment only if you have the authentication mechanism enabled.
# CACHE_PASS=<empty>

# Cache max size in bytes
CACHE_SIZE=104857600

# Item expiration time in seconds
CACHE_EXP=604800

######################## MESSAGE BROKER CONFIGURATION #########################
#
# Server communication settings with RabbitMQ.
# By default, this file configures the server to connect to the message broker
# using the default RabbitMQ settings.
#
# NOTE: The default AMQP protocol configured is the non-secure version, to use
# the secure version set the AMPQ_PROTOCOL to amqps instead of amqp.

AMQP_PROTOCOL=amqp
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=guest
AMQP_PASS=guest

# Translation Generation queues
TRANSLATOR_QUEUE=translate.to_text
GLOSS_REFINEMENT_QUEUE=refine.gloss


# CAUTION: Changing this setting may cause messaging consumer failure
API_CONSUMER_QUEUE=amq.rabbitmq.reply-to
